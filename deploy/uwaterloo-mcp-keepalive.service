[Unit]
Description=UWaterloo MCP Learn session silent keep-alive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/uwaterloo-mcp
EnvironmentFile=/opt/uwaterloo-mcp/.env
ExecStart=/usr/bin/node /opt/uwaterloo-mcp/dist/scripts/keep-alive.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/uwaterloo-mcp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
