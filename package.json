    "@modelcontextprotocol/server": "2.0.0",
    "@sparticuz/chromium": "149.0.0",
    "@vercel/blob": "2.8.0",
    "express": "5.2.1",
    "puppeteer-core": "25.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
