# --- Required -------------------------------------------------------------

# The bearer token your MCP client sends to reach this server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# All endpoints (/mcp, /setup, /api/keep-alive, /calendar.ics) require this token
# (or CRON_SECRET for /api/keep-alive).
MCP_AUTH_TOKEN=

# Recommended: separate 24+ char secret used to derive the AES-256-GCM key that encrypts
# `.session.enc` on disk or in Vercel Blob. When unset, the key is derived from MCP_AUTH_TOKEN.
SESSION_ENCRYPTION_KEY=

# Optional secret used ONLY to authenticate external cron calls to /api/keep-alive
# (`Authorization: Bearer <CRON_SECRET>` or `X-Cron-Secret: <CRON_SECRET>`).
# Leaving this unset disables cron header triggers on /api/keep-alive.
CRON_SECRET=

# Optional persistent directory where auto-generated `.env` and `.session.enc` are written
# (e.g., `/data` inside Docker).
DATA_DIR=

# --- Piazza ---------------------------------------------------------------
# Your UWaterloo email and your Piazza password. The server signs in on its own
# and re-signs in whenever the Piazza session expires.

PIAZZA_EMAIL=
PIAZZA_PASSWORD=

# --- Learn & Duo ----------------------------------------------------------
# Optional: your WatIAM username and password. Leave blank to enter in /setup
# without storing credentials on disk.
#
# A bare username has @uwaterloo.ca appended, so "jsmith" and "jsmith@uwaterloo.ca"
# are equivalent here. This is the WatIAM login, which is not always the same as an
# @uwaterloo.ca email alias.

UWATERLOO_USERNAME=
UWATERLOO_PASSWORD=

# Optional Duo passcode providers for interactive sign-in (never used during silent keep-alive;
# interactive sign-in prefers SMS/passcode and never automatically sends a Duo Push):
#   UWATERLOO_DUO_PASSCODE       - one-shot passcode consumed on first read
#   UWATERLOO_DUO_PASSCODE_FILE  - path to a file whose first line contains a passcode
#   UWATERLOO_DUO_PASSCODE_HOOK  - executable path (or JSON argv array) returning a passcode on stdout
#   UWATERLOO_DUO_PASSCODE_HOOK_ARGS - optional JSON string array of extra arguments
UWATERLOO_DUO_PASSCODE=
UWATERLOO_DUO_PASSCODE_FILE=
UWATERLOO_DUO_PASSCODE_HOOK=
UWATERLOO_DUO_PASSCODE_HOOK_ARGS=

# Optional. A Brightspace session cookie, which /setup can also establish for you
# by signing in. Set it here to start with a working session. It expires after
# 180 idle minutes unless kept alive.
D2L_COOKIE=

# --- Crowdmark (Read-Only) ------------------------------------------------
# Optional. Allowed hosts: app.crowdmark.com (default) or crowdmark.com.
CROWDMARK_HOST=https://app.crowdmark.com
# Optional. Your Crowdmark Cookie header (can also be pasted in /setup).
CROWDMARK_COOKIE=

# --- Optional -------------------------------------------------------------

D2L_HOST=https://learn.uwaterloo.ca
PORT=8787
# Keep bound to loopback when running locally or behind a reverse proxy / tunnel.
HOST=127.0.0.1
MCP_PUBLIC_URL=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
